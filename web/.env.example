# Base URL of the Fluxboard API (no trailing slash). Public: baked into the client bundle.
NEXT_PUBLIC_API_BASE=http://localhost:8080/api/v1

# Legal operator facts shown on /legal/* (report B09, ADR-031). Optional in dev
# (pages show "[… not configured]"); a release build (FLUXBOARD_RELEASE=1) fails
# without them.
NEXT_PUBLIC_LEGAL_ENTITY=
NEXT_PUBLIC_LEGAL_ADDRESS=
NEXT_PUBLIC_LEGAL_PRIVACY_EMAIL=
NEXT_PUBLIC_LEGAL_SECURITY_EMAIL=
NEXT_PUBLIC_LEGAL_GOVERNING_LAW=
